<IfModule mod_rewrite.c>
    RewriteEngine On

    # Force HTTPS and www
    RewriteCond %{HTTP_HOST} !^www\.baanlist\.com$ [NC,OR]
    RewriteCond %{HTTPS} off
    RewriteRule ^ https://www.baanlist.com%{REQUEST_URI} [L,R=301]

    # Front controller
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^ index.php [L]
</IfModule>

# ------------------------------
# Cache static files long-term
# ------------------------------
<IfModule mod_expires.c>
    ExpiresActive On

    # CSS, JS, fonts → 1 year
    ExpiresByType text/css "access plus 1 year"
    ExpiresByType application/javascript "access plus 1 year"
    ExpiresByType application/x-javascript "access plus 1 year"
    ExpiresByType font/woff "access plus 1 year"
    ExpiresByType font/woff2 "access plus 1 year"
    ExpiresByType font/ttf "access plus 1 year"
    ExpiresByType font/otf "access plus 1 year"

    # Images → 1 day or 1 hour, since new images can be posted anytime
    ExpiresByType image/jpg "access plus 1 day"
    ExpiresByType image/jpeg "access plus 1 day"
    ExpiresByType image/png "access plus 1 day"
    ExpiresByType image/gif "access plus 1 day"
</IfModule>

# ------------------------------
# Enable compression
# ------------------------------
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/css application/javascript application/json
    AddOutputFilterByType DEFLATE font/woff font/woff2 font/ttf font/otf
    Header append Vary User-Agent
</IfModule>
